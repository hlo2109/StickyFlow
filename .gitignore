# ==============================================================================
# StickyFlow .gitignore
# PROTECCIÓN ESTRICTA DE DATOS PERSONALES, CLAVES Y NOTAS PRIVADAS
# ==============================================================================

# Dependencias
node_modules/
package-lock.json.backup

# Compilaciones, instaladores y ejecutables de Windows
dist/
release/
*.exe
*.dll
*.node
*.asar
*.7z
*.zip

# Notas personales del usuario (PRIVACIDAD TOTAL: NINGUNA NOTA SE SUBE A GIT)
mis_notas/
StickyFlow_Notas/
*.local
notes.json
settings.json

# Archivos de registro y logs
*.log
debug.log
out.log
err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables de entorno y credenciales
.env
.env.local
.env.*.local
*.key
*.pem
*.cert

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
