# ===== StickyFlow Server — variables de entorno =====
# Copia este archivo a .env (local) o pega estas variables en Dokploy → Environment.

# URL pública con la que entras (sin barra final). Se usa en los enlaces de invitación y de recuperar cuenta.
PUBLIC_URL=https://notas.tu-dominio.com

# Puerto interno del contenedor (en Dokploy: el mismo que pongas en el dominio)
PORT=3000

# Registro: open = cualquiera con la URL | invite = solo con enlace de invitación (recomendado) | closed = nadie nuevo
# El PRIMER usuario siempre puede registrarse y queda como administrador.
SIGNUP_MODE=invite
INVITE_TTL_DAYS=7
SESSION_DAYS=30

# Detrás de Dokploy/Traefik: true (para ver la IP real de cada visitante y limitar intentos bien)
TRUST_PROXY=true

# Correo (opcional pero necesario para: recuperar contraseña, verificar correos y enviar invitaciones por email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StickyFlow <no-reply@tu-dominio.com>
